# Copy this file to .env (same folder) and fill in your own values.
# .env is private and is never uploaded to GitHub.

# Make a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='change-me'

# True on your own computer while developing. Leave out (or False) anywhere else.
DJANGO_DEBUG=True

# Optional. Comma-separated host names. Default: 127.0.0.1,localhost
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost